{
  "openapi": "3.0.3",
  "info": {
    "title": "Project Manager API",
    "version": "1.0.0",
    "description": "Swagger documentation for the Project Manager backend API."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "User",
      "description": "User authentication endpoints"
    },
    {
      "name": "Project",
      "description": "Project management endpoints"
    },
    {
      "name": "Skill",
      "description": "Skill management endpoints"
    },
    {
      "name": "Message",
      "description": "Message management endpoints"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UserCredentials": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "example": "user@example.com" },
          "password": { "type": "string", "example": "strongpassword" }
        },
        "required": ["email", "password"]
      },
      "RegisterUser": {
        "type": "object",
        "properties": {
          "username": { "type": "string", "example": "john_doe" },
          "email": { "type": "string", "example": "john@example.com" },
          "password": { "type": "string", "example": "strongpassword" }
        },
        "required": ["username", "email", "password"]
      },
      "ProjectInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "Project Manager App" },
          "description": { "type": "string", "example": "A full stack project management app." },
          "technologies": { "type": "array", "items": { "type": "string" }, "example": ["Node.js", "React"] },
          "githubLink": { "type": "string", "example": "https://github.com/example/project" },
          "liveLink": { "type": "string", "example": "https://example.com" },
          "image": { "type": "string", "example": "https://example.com/image.png" }
        },
        "required": ["title", "description", "technologies", "githubLink", "liveLink", "image"]
      },
      "SkillInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "JavaScript" },
          "level": { "type": "integer", "example": 5 }
        },
        "required": ["name", "level"]
      },
      "MessageInput": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Hello, this is a new message." }
        },
        "required": ["message"]
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["User"],
        "summary": "Register a new user",
        "description": "Create a new user account with username, email, and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterUser" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          },
          "400": {
            "description": "Invalid input or user already exists"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["User"],
        "summary": "Login a user",
        "description": "Authenticate an existing user and return a JWT token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserCredentials" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User authenticated successfully"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "tags": ["Project"],
        "summary": "Get all projects",
        "description": "Fetch a list of all projects.",
        "responses": {
          "200": {
            "description": "A list of projects"
          }
        }
      },
      "post": {
        "tags": ["Project"],
        "summary": "Create a new project",
        "description": "Create a new project. Requires authentication.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "tags": ["Project"],
        "summary": "Get a project by ID",
        "description": "Retrieve a single project by its ID.",
        "parameters": [{
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "responses": {
          "200": { "description": "Project data returned" },
          "404": { "description": "Project not found" }
        }
      },
      "put": {
        "tags": ["Project"],
        "summary": "Update a project",
        "description": "Update project fields. Requires authentication and ownership.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Project updated successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: not project owner" },
          "404": { "description": "Project not found" }
        }
      },
      "delete": {
        "tags": ["Project"],
        "summary": "Delete a project",
        "description": "Delete an existing project. Requires authentication and ownership.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "responses": {
          "200": { "description": "Project deleted successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: not project owner" },
          "404": { "description": "Project not found" }
        }
      }
    },
    "/api/skills": {
      "get": {
        "tags": ["Skill"],
        "summary": "Get all skills",
        "description": "Fetch all skills stored in the system.",
        "responses": {
          "200": { "description": "A list of skills" }
        }
      },
      "post": {
        "tags": ["Skill"],
        "summary": "Create a new skill",
        "description": "Create a new skill for the authenticated user.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SkillInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Skill created successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/skills/{id}": {
      "put": {
        "tags": ["Skill"],
        "summary": "Update a skill",
        "description": "Update a skill by ID. Requires authentication and ownership.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SkillInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Skill updated successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: not skill owner" },
          "404": { "description": "Skill not found" }
        }
      },
      "delete": {
        "tags": ["Skill"],
        "summary": "Delete a skill",
        "description": "Delete a skill by ID. Requires authentication and ownership.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "responses": {
          "200": { "description": "Skill deleted successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: not skill owner" },
          "404": { "description": "Skill not found" }
        }
      }
    },
    "/api/skills/my-skills": {
      "get": {
        "tags": ["Skill"],
        "summary": "Get authenticated user skills",
        "description": "Fetch skills owned by the currently authenticated user.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "A list of the user's skills" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/messages": {
      "get": {
        "tags": ["Message"],
        "summary": "Get messages",
        "description": "Fetch messages for the authenticated user.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "A list of messages" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["Message"],
        "summary": "Create a message",
        "description": "Create a new message for the authenticated user.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MessageInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "Message created successfully" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/messages/{id}": {
      "put": {
        "tags": ["Message"],
        "summary": "Update a message",
        "description": "Update a message by ID. Requires authentication and message ownership.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MessageInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "Message updated successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: not message owner" },
          "404": { "description": "Message not found" }
        }
      },
      "delete": {
        "tags": ["Message"],
        "summary": "Delete a message",
        "description": "Delete a message by ID. Requires authentication and message ownership.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }],
        "responses": {
          "200": { "description": "Message deleted successfully" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden: not message owner" },
          "404": { "description": "Message not found" }
        }
      }
    }
  }
}
